# Cổng chạy server
PORT=3000
# Chuỗi bí mật để ký token đăng nhập. BẮT BUỘC đổi khi chạy thật (chuỗi dài, ngẫu nhiên)
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-dai
# Đường dẫn file database SQLite
DB_PATH=./data/thebai.db
# Thư mục frontend để server phục vụ luôn (để trống nếu host frontend riêng)
FRONTEND_DIR=../frontend
# Cho phép frontend ở tên miền khác gọi API (phân tách bằng dấu phẩy, * = tất cả)
CORS_ORIGIN=*
